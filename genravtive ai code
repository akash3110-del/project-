# Step 1: Reconstruct text from tokens
seven_text_data['lemmatized_text'] = seven_text_data['lemmatized_tokens'].apply(lambda tokens: ' '.join(tokens))
# Step 2: Bag of Words (BoW)
bow_vectorizer = CountVectorizer()
