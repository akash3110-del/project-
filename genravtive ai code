# Function to clean text
def clean_text(text):
    """
    Removes unnecessary characters, punctuation, and digits from the text.
    """
    if not isinstance(text, str):
        return ""

    # Remove digits
    text = re.sub(r'\d+', '', text)

    # Remove punctuation
    text = text.translate(str.maketrans('', '', string.punctuation))

    # Remove special characters or non-ASCII
    text = re.sub(r'[^\x00-\x7F]+', '', text)  # Optional: keep only ASCII

    # Remove extra spaces
    text = re.sub(r'\s+', ' ', text).strip()

    return text



