from sklearn.metrics import confusion_matrix, precision_score, recall_score, f1_score, matthews_corrcoef, accuracy_score
import numpy as np

def evaluate_with_custom_metrics(y_true, y_pred, model_name="Model"):
    # Get confusion matrix components
    tn, fp, fn, tp = confusion_matrix(y_true, y_pred).ravel()

    # Basic metrics
    acc = accuracy_score(y_true, y_pred) * 100
    precision = precision_score(y_true, y_pred, zero_division=0) * 100
    recall = recall_score(y_true, y_pred, zero_division=0) * 100  # Sensitivity / TPR
    specificity = (tn / (tn + fp)) * 100 if (tn + fp) > 0 else 0
    f1 = f1_score(y_true, y_pred, zero_division=0) * 100

    # Matthews Correlation Coefficient (MCC)
    mcc_numerator = (tp * tn) - (fp * fn)
    mcc_denominator = np.sqrt((tp + fp) * (tp + fn) * (tn + fp) * (tn + fn))
    mcc = mcc_numerator / mcc_denominator if mcc_denominator > 0 else 0

    # Print results
    print(f"\n Evaluation for: {model_name}")
    print(f"Accuracy       : {acc:.2f}%")
    print(f"Precision (P)  : {precision:.2f}%")
    print(f"Recall (TPR)   : {recall:.2f}%")
    print(f"Specificity    : {specificity:.2f}%")
    print(f"F1-Score       : {f1:.2f}%")
    print(f"MCC            : {mcc:.4f}")
    print(f"Confusion Matrix: TP={tp}, TN={tn}, FP={fp}, FN={fn}")
