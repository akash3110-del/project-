# Step 3: TF-IDF with L2 norm, smoothing, and sublinear TF
tfidf_vectorizer = TfidfVectorizer(
    norm='l2',             # L2 normalization
    smooth_idf=True,       # Prevents division by zero
    sublinear_tf=True      # Use TF = 1 + log(TF)
)
tfidf_matrix = tfidf_vectorizer.fit_transform(seven_text_data['lemmatized_text'])
# Step 4: fastText Embeddings (Custom-trained)
tokens_list = seven_text_data['lemmatized_tokens'].tolist()
fasttext_model = FastText(
    sentences=tokens_list,
    vector_size=300,  # vector dimensionality
    window=5,
    min_count=3,
    sg=1,  # 0 = CBOW, 1 = Skip-gram
    min_n=3,
    max_n=6,
    bucket=200000,
    epochs=1
)
# Function to get average embedding for each document
def get_fasttext_embedding(tokens):
    vectors = [fasttext_model.wv[token] for token in tokens if token in fasttext_model.wv]
    return np.mean(vectors, axis=0) if vectors else np.zeros(300)
seven_text_data['fasttext_embedding'] = seven_text_data['lemmatized_tokens'].apply(get_fasttext_embedding)
